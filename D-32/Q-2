//Q64. Find the digit that occurs the most times in an integer number
#include <stdio.h>
int main() {
    long long n;
    int count[10] = {0}, digit, i, maxCount = 0, maxDigit = 0;
    printf("Enter a number: ");
    scanf("%lld", &n);

    if (n == 0) count[0]++;
    while (n != 0) {
        digit = n % 10;
        if (digit < 0) digit = -digit; /* handle negative numbers */
        count[digit]++;
        n /= 10;
    }

    for (i = 0; i < 10; i++) {
        if (count[i] > maxCount) {
            maxCount = count[i];
            maxDigit = i;
        }
    }
    printf("Digit that occurs the most = %d (appears %d times)\n", maxDigit, maxCount);
    return 0;
}
