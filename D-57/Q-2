//Q114. Write a program to take a string s as input. The task is to find the length of the longest substring without repeating characters. Print the length as output.

#include <stdio.h>
#include <string.h>
int main()
{
    char s[100];
    int i, j, k;
    int count, max = 0, repeated;
    printf("Enter string: ");
    scanf("%s", s);
    for(i = 0; s[i] != '\0'; i++)
    {
        count = 0;
        for(j = i; s[j] != '\0'; j++)
        {
            repeated = 0;
            for(k = i; k < j; k++)
            {
                if(s[k] == s[j])
                {
                    repeated = 1;
                    break;
                }
            }
            if(repeated)
                break;
            count++;
        }
        if(count > max)
            max = count;
    }
    printf("%d\n", max);
    return 0;
}
