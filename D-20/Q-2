//Q40. Write a program to find the 1's complement of a binary number and print it
#include <stdio.h>
#include <math.h>
int main() {
    long long binary, complement = 0;
    int remainder, i = 0;
    printf("Enter a binary number: ");
    scanf("%lld", &binary);

    while (binary != 0) {
        remainder = binary % 10;
        int flipped = (remainder == 0) ? 1 : 0;
        complement += flipped * (long long)pow(10, i);
        i++;
        binary /= 10;
    }
    printf("1's complement = %lld\n", complement);
    return 0;
}
