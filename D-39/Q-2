//Q78. Find the sum of main diagonal elements for a square matrix
#include <stdio.h>
int main() {
    int n, i, j, matrix[10][10], sum = 0;
    printf("Enter size of square matrix (n x n): ");
    scanf("%d", &n);

    printf("Enter matrix elements:\n");
    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", &matrix[i][j]);

    for (i = 0; i < n; i++)
        sum += matrix[i][i];

    printf("Sum of main diagonal = %d\n", sum);
    return 0;
}
