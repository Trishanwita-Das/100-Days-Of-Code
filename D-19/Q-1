//Q37. Write a program to find the LCM of two numbers
#include <stdio.h>
int main() {
    int a, b, larger;
    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);
    larger = (a > b) ? a : b;
    while (1) {
        if (larger % a == 0 && larger % b == 0) {
            printf("LCM = %d\n", larger);
            break;
        }
        larger++;
    }
    return 0;
}
