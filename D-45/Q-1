//Q89. Count frequency of a given character in a string
#include <stdio.h>
int main() {
    char str[100], target;
    int i, count = 0;
    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);
    printf("Enter character to count: ");
    scanf("%c", &target);

    for (i = 0; str[i] != '\0'; i++) {
        if (str[i] == target)
            count++;
    }
    printf("'%c' occurs %d times\n", target, count);
    return 0;
}
