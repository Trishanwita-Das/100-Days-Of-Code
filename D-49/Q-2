//Q98. Print initials of a name with the surname displayed in full
#include <stdio.h>
#include <string.h>
int main() {
    char name[100], words[10][30];
    int i, wordCount = 0, j = 0, k = 0;
    printf("Enter full name: ");
    fgets(name, sizeof(name), stdin);
    name[strcspn(name, "\n")] = '\0';

    /* split into words */
    for (i = 0; name[i] != '\0'; i++) {
        if (name[i] != ' ') {
            words[wordCount][j] = name[i];
            j++;
        } else if (j > 0) {
            words[wordCount][j] = '\0';
            wordCount++;
            j = 0;
        }
    }
    if (j > 0) {
        words[wordCount][j] = '\0';
        wordCount++;
    }

    for (k = 0; k < wordCount - 1; k++)
        printf("%c. ", words[k][0]);
    printf("%s\n", words[wordCount - 1]);
    return 0;
}
