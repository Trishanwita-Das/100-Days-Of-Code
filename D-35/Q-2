//Q70. Rotate an array to the right by k positions
#include <stdio.h>
int main() {
    int n, i, arr[100], temp[100], k, newIndex;
    printf("Enter number of elements: ");
    scanf("%d", &n);
    printf("Enter %d elements: ", n);
    for (i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    printf("Enter value of k: ");
    scanf("%d", &k);
    k = k % n;

    for (i = 0; i < n; i++) {
        newIndex = (i + k) % n;
        temp[newIndex] = arr[i];
    }

    printf("Array after rotating right by %d: ", k);
    for (i = 0; i < n; i++)
        printf("%d ", temp[i]);
    printf("\n");
    return 0;
}
